{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ktoya-friends-beta",
  "account_id": "a2b914633286a8c858fca22758a182c4",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "FRIENDS_DB",
      "database_name": "ktoya-friends-beta-db",
      "database_id": "057231e4-8fde-445b-8fc1-84ce624f5c43",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FRIENDS_AUDIO",
      "bucket_name": "ktoya-friends-beta-audio"
    }
  ],
  "vars": {
    "FRIENDS_BETA_MODE": "true",
    "FRIENDS_BUILD_ID": "closed-beta-live-voice-2026-09-07",
    "KTOYA_LIVE_BETA_ENABLED": "true",
    "KTOYA_LIVE_KEY_ID": "ajefn9sljo4al88nvtda",
    "KTOYA_LIVE_FOLDER_ID": "b1gkl7lo86seu967m35j",
    "KTOYA_LIVE_MODEL": "speech-realtime-260528",
    "KTOYA_LIVE_KEY_EXPIRES_AT": "2026-09-13T21:00:00.000Z",
    "KTOYA_LIVE_KEY_SCOPES": "yc.ai.foundationModels.execute",
    "KTOYA_LIVE_IAM_VERIFIED_AT": "2026-09-07T13:13:27.060Z",
    "KTOYA_LIVE_TARIFF_VERIFIED_AT": "2026-09-07T13:13:27.060Z",
    "KTOYA_LIVE_BILLING_VERIFIED_AT": "2026-09-07T13:13:27.060Z",
    "KTOYA_LIVE_INPUT_AUDIO_RUB_PER_SECOND": "0.0264",
    "KTOYA_LIVE_OUTPUT_AUDIO_RUB_PER_SECOND": "0.0203",
    "KTOYA_LIVE_INPUT_TEXT_RUB_PER_1K_TOKENS": "0.1",
    "KTOYA_LIVE_OUTPUT_TEXT_RUB_PER_1K_TOKENS": "0.2",
    "KTOYA_LIVE_CAP_RUB": "100"
  },
  "observability": { "enabled": false }
}
